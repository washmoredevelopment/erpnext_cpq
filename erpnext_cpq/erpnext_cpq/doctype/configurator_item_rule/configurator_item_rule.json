	"fields": [
		{
			"fieldname": "item_code",
			"fieldtype": "Link",
			"in_list_view": 1,
			"label": "Item",
			"options": "Item",
			"reqd": 1
		},
		{
			"fetch_from": "item_code.item_name",
			"fieldname": "item_name",
			"fieldtype": "Data",
			"in_list_view": 1,
			"label": "Item Name",
			"read_only": 1
		},
		{
			"default": "1",
			"fieldname": "base_qty",
			"fieldtype": "Float",
			"in_list_view": 1,
			"label": "Base Quantity",
			"reqd": 1
		},
		{
			"fieldname": "column_break_condition",
			"fieldtype": "Column Break"
		},
		{
			"default": "Always",
			"fieldname": "condition_type",
			"fieldtype": "Select",
			"in_list_view": 1,
			"label": "Condition Type",
			"options": "Always\nWhen Equals\nWhen Set\nWhen Not Empty\nWhen Greater Than\nWhen Less Than\nWhen In List",
			"reqd": 1
		},
		{
			"depends_on": "eval:doc.condition_type !== 'Always'",
			"description": "Select the option to check",
			"fieldname": "option_name",
			"fieldtype": "Select",
			"label": "Option Name"
		},
		{
			"depends_on": "eval:['When Equals', 'When Greater Than', 'When Less Than', 'When In List'].includes(doc.condition_type)",
			"description": "Value to compare against. For 'When Equals', select from choices. For numeric/list, enter manually.",
			"fieldname": "option_value",
			"fieldtype": "Data",
			"label": "Option Value"
		},
		{
			"depends_on": "eval:['When Greater Than', 'When Less Than'].includes(doc.condition_type)",
			"fieldname": "comparison",
			"fieldtype": "Select",
			"label": "Comparison",
			"options": "\n>\n>=\n<\n<=\n="
		},
		{
			"fieldname": "column_break_qty",
			"fieldtype": "Column Break"
		},
		{
			"description": "Optional: Pull quantity from a numeric option instead of using Base Qty",
			"fieldname": "qty_from_option",
			"fieldtype": "Select",
			"label": "Qty From Option"
		},
		{
			"default": "1",
			"description": "Multiply the quantity from option by this value",
			"fieldname": "qty_multiplier",
			"fieldtype": "Float",
			"label": "Qty Multiplier"
		},
		{
			"fieldname": "section_break_description",
			"fieldtype": "Section Break",
			"label": "Description"
		},
		{
			"description": "Custom description text to use instead of the item's default description",
			"fieldname": "description_override",
			"fieldtype": "Small Text",
			"label": "Description Override"
		},
		{
			"description": "Pull description from another option's value (e.g., a text field)",
			"fieldname": "description_from_option",
			"fieldtype": "Select",
			"label": "Description From Option"
		}
	],
